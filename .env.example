NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/work_assistant
REDIS_URL=redis://localhost:6379

OWNER_WHATSAPP_NUMBER=972XXXXXXXXX
OWNER_TIMEZONE=Asia/Jerusalem
OWNER_LANGUAGE=he

WHATSAPP_VERIFY_TOKEN=change_me
WHATSAPP_ACCESS_TOKEN=change_me
WHATSAPP_PHONE_NUMBER_ID=change_me
WHATSAPP_BUSINESS_ACCOUNT_ID=change_me
META_APP_SECRET=change_me
META_APP_ID=change_me

GOOGLE_CLIENT_ID=change_me
GOOGLE_CLIENT_SECRET=change_me
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=change_me_32_bytes_long_secret_key

OPENAI_API_KEY=change_me
ANTHROPIC_API_KEY=change_me
# Free Whisper fallback (console.groq.com). When set, transcription falls back to
# Groq if OpenAI fails (e.g. out of quota). Set AI_TRANSCRIPTION_PROVIDER=groq to
# use it as the primary transcriber.
GROQ_API_KEY=
AI_PLANNER_PROVIDER=anthropic
AI_TRANSCRIPTION_PROVIDER=openai
AI_VISION_PROVIDER=openai

# Planner router: 'true'/'1' enables a cheap intent-classification call that
# routes each message to a per-intent specialist. Anything else keeps the general
# monolith — identical behaviour. ON by default; set to 'false' to roll back.
PLANNER_ROUTER_ENABLED=true

# Proactive email triage: scan unread inbox mail every 15 min (work hours only)
# and push a WhatsApp digest of the important ones. Set to false to disable.
EMAIL_TRIAGE_ENABLED=true

# Meeting prep: ~30 min before each calendar event, push a WhatsApp brief
# (attendees, recent mail with them, related open tasks, Meet link).
MEETING_PREP_ENABLED=true

# Morning email review: each work-day morning (after the daily plan), read
# yesterday's primary inbox and send ONE numbered list of candidate tasks +
# schedule items to approve ("הכל" / numbers). Nothing is added without a reply.
MORNING_EMAIL_REVIEW_ENABLED=true

# Flight deal watcher: TLV↔ZNZ round trip for two, Shabbat-safe, every 3 hours.
# OPT-IN — unlike the other watchers this one bills per run (SerpApi), so it
# stays idle until BOTH the flag is true and a key is present.
# Budget maths: SEARCHES_PER_RUN x 8 runs/day. 12 x 8 = ~96 requests/day.
FLIGHT_WATCH_ENABLED=false
SERPAPI_API_KEY=
FLIGHT_WATCH_ORIGIN=TLV
FLIGHT_WATCH_DESTINATION=ZNZ
# Outbound dates searched across this range, each paired with 6/7/8 nights.
FLIGHT_WATCH_WINDOW_START=2026-07-26
FLIGHT_WATCH_WINDOW_END=2026-08-16
FLIGHT_WATCH_MIN_NIGHTS=6
FLIGHT_WATCH_MAX_NIGHTS=8
FLIGHT_WATCH_ADULTS=2
# Threshold for the WHOLE booking (both tickets): $1,200 per person = $2,400.
FLIGHT_WATCH_ALERT_TOTAL=2400
# 1 = nonstop only, 2 = up to 1 stop, 3 = up to 2 stops.
FLIGHT_WATCH_MAX_STOPS=2
FLIGHT_WATCH_CURRENCY=USD
FLIGHT_WATCH_SEARCHES_PER_RUN=12
FLIGHT_WATCH_VERIFY_PER_RUN=3
FLIGHT_WATCH_DIGEST_HOUR=9

# Web research sub-agent. Leave as 'none' to disable (planner falls back to
# assume/ask). Set 'brave' or 'tavily' and fill the matching key to enable.
WEB_SEARCH_PROVIDER=none
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# Protect the /admin dashboard (it exposes private data). When set, /admin needs
# this token: open https://<host>/admin and enter any user + this as the password,
# or pass ?token=... . Leave empty to keep the dashboard open.
ADMIN_TOKEN=

STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage

DAILY_PLAN_TIME=07:30
MIDDAY_CHECKIN_TIME=13:00
END_OF_DAY_TIME=18:30
