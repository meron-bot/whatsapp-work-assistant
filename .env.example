NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/work_assistant
REDIS_URL=redis://localhost:6379

OWNER_WHATSAPP_NUMBER=972XXXXXXXXX
OWNER_TIMEZONE=Asia/Jerusalem
OWNER_LANGUAGE=he

WHATSAPP_VERIFY_TOKEN=change_me
WHATSAPP_ACCESS_TOKEN=change_me
WHATSAPP_PHONE_NUMBER_ID=change_me
WHATSAPP_BUSINESS_ACCOUNT_ID=change_me
META_APP_SECRET=change_me
META_APP_ID=change_me

GOOGLE_CLIENT_ID=change_me
GOOGLE_CLIENT_SECRET=change_me
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=change_me_32_bytes_long_secret_key

OPENAI_API_KEY=change_me
ANTHROPIC_API_KEY=change_me
AI_PLANNER_PROVIDER=anthropic
AI_TRANSCRIPTION_PROVIDER=openai
AI_VISION_PROVIDER=openai

# Planner router: 'true'/'1' enables a cheap intent-classification call that
# routes each message to a per-intent specialist. Anything else (incl. unset)
# keeps the general monolith — identical behaviour. Turn on only after deploy.
PLANNER_ROUTER_ENABLED=false

# Web research sub-agent. Leave as 'none' to disable (planner falls back to
# assume/ask). Set 'brave' or 'tavily' and fill the matching key to enable.
WEB_SEARCH_PROVIDER=none
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage

DAILY_PLAN_TIME=07:30
MIDDAY_CHECKIN_TIME=13:00
END_OF_DAY_TIME=18:30
