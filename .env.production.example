# ============================================================
# PRODUCTION ENV — copy to .env and fill in the REAL values.
# Lines marked [YOU PROVIDE] are the ONLY things that require your action.
# Everything else has a sane default for the docker-compose.full.yml stack.
# ============================================================

NODE_ENV=production
PORT=3000

# Your public HTTPS URL (PaaS gives you one; with Caddy it is https://<your-domain>)
APP_BASE_URL=https://your-domain.example.com          # [YOU PROVIDE]
PUBLIC_DOMAIN=your-domain.example.com                  # [YOU PROVIDE] (only needed for the caddy https profile)

# --- Database & Redis (defaults match docker-compose.full.yml; override if managed) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password            # [YOU PROVIDE] pick a strong password
POSTGRES_DB=work_assistant
# DATABASE_URL is required. REDIS_URL is OPTIONAL: if you do not provide a real
# Redis, the app processes messages inline (no queue) — perfect for one owner.
# DATABASE_URL=postgresql://user:pass@host:5432/work_assistant
# REDIS_URL=redis://host:6379            # optional
# QUEUE_DRIVER=inline                    # optional; auto-detected (inline when no Redis)

# --- Owner ---
OWNER_WHATSAPP_NUMBER=9725XXXXXXXX                     # [YOU PROVIDE] your WhatsApp number, digits only
OWNER_NAME=פליי                                        # the assistant addresses you by this name
OWNER_TIMEZONE=Asia/Jerusalem
OWNER_LANGUAGE=he

# --- WhatsApp Business Cloud API (Meta) ---
WHATSAPP_VERIFY_TOKEN=pick_any_long_random_string      # [YOU PROVIDE] you invent this; reused in Meta
WHATSAPP_ACCESS_TOKEN=EAA...                           # [YOU PROVIDE] permanent System User token
WHATSAPP_PHONE_NUMBER_ID=000000000000                  # [YOU PROVIDE]
WHATSAPP_BUSINESS_ACCOUNT_ID=000000000000              # [YOU PROVIDE]
META_APP_SECRET=...                                    # [YOU PROVIDE] App Settings -> Basic
META_APP_ID=000000000000                               # [YOU PROVIDE] needed for webhook auto-registration

# --- Google OAuth (Calendar / Tasks / Drive / Docs / Gmail) ---
GOOGLE_CLIENT_ID=...apps.googleusercontent.com         # [YOU PROVIDE]
GOOGLE_CLIENT_SECRET=...                               # [YOU PROVIDE]
GOOGLE_REDIRECT_URI=https://your-domain.example.com/auth/google/callback   # [YOU PROVIDE host]
GOOGLE_TOKEN_ENCRYPTION_KEY=generate_32plus_byte_secret # [YOU PROVIDE] e.g. `openssl rand -hex 32`

# --- AI providers ---
OPENAI_API_KEY=sk-...                                  # [YOU PROVIDE] (speech-to-text + vision)
ANTHROPIC_API_KEY=sk-ant-...                           # [YOU PROVIDE] (planning + drafting)
GROQ_API_KEY=gsk_...                                   # [OPTIONAL] free Whisper fallback (console.groq.com)
AI_PLANNER_PROVIDER=anthropic
AI_TRANSCRIPTION_PROVIDER=openai                       # set to 'groq' to use Groq as primary transcriber
AI_VISION_PROVIDER=openai
# Cost tiering: cheap model for routine planning, heavy model only when needed.
ANTHROPIC_MODEL_LIGHT=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_HEAVY=claude-sonnet-4-6

# --- Planner router (cheap intent classification → per-intent specialist) ---
# ON by default. Set to false to fall back to the single general planner.
PLANNER_ROUTER_ENABLED=true

# Proactive email triage: scan unread inbox mail every 15 min (work hours only)
# and push a WhatsApp digest of the important ones. Set to false to disable.
EMAIL_TRIAGE_ENABLED=true

# Meeting prep: ~30 min before each calendar event, push a WhatsApp brief
# (attendees, recent mail with them, related open tasks, Meet link).
MEETING_PREP_ENABLED=true

# Morning email review: each work-day morning (after the daily plan), read
# yesterday's primary inbox and send ONE numbered list of candidate tasks +
# schedule items to approve ("הכל" / numbers). Nothing is added without a reply.
MORNING_EMAIL_REVIEW_ENABLED=true

# --- Admin dashboard protection ---
# /admin exposes private data. Set a long random token to require it (open the
# dashboard and enter any user + this token as the password). Leave empty = open.
ADMIN_TOKEN=                                           # [YOU PROVIDE] recommended in production

# --- Storage ---
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage

# --- Daily planning times (owner timezone) ---
DAILY_PLAN_TIME=07:30
MIDDAY_CHECKIN_TIME=13:00
END_OF_DAY_TIME=18:30
